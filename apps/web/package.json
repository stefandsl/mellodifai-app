{
  "name": "@mellodifai/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3001",
    "validate:recipes": "tsx scripts/validate-recipes.ts",
    "build": "pnpm run validate:recipes && next build && node scripts/write-version.mjs",
    "start": "next start -H 127.0.0.1 -p 3000",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test && playwright test -c playwright.site.config.ts",
    "e2e:site": "playwright test -c playwright.site.config.ts",
    "judge:j2": "node scripts/site-study/judge-strips.mjs",
    "site:css": "node scripts/build-site-astryx-css.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astryxdesign/cli": "0.7.17",
    "@astryxdesign/core": "0.7.17",
    "@base-ui/react": "^1.9.0",
    "@fontsource/oswald": "^5.2.8",
    "@mellodifai/shared": "workspace:^",
    "@modelcontextprotocol/server": "2.4.0",
    "@stylexjs/stylex": "0.19.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.66.0",
    "next": "16.4.6",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "wasm-media-encoders": "0.7.0",
    "zod": "^4.6.7",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "lighthouse": "12.8.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
