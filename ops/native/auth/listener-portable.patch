Supabase Auth v2.197.0: build on platforms without SO_REUSEPORT.

Upstream sets SO_REUSEPORT through golang.org/x/sys/unix inside cmd/serve_cmd.go,
which does not compile on Windows. This patch moves that socket option into a
file built only on Unix (behaviour unchanged there) and adds a no-op for every
other platform. Applied by ops/lib/native/build.ts at install time; the pinned
source archive itself is never modified.

--- /dev/null
+++ b/cmd/listen_reuseport_other.go
@@ -0,0 +1,11 @@
+//go:build !unix
+
+package cmd
+
+import "syscall"
+
+// listenControl is a no-op where SO_REUSEPORT does not exist (Windows). The
+// listener then binds exclusively, which is what a single local service needs.
+func listenControl(network, address string, c syscall.RawConn) error {
+	return nil
+}
--- /dev/null
+++ b/cmd/listen_reuseport_unix.go
@@ -0,0 +1,21 @@
+//go:build unix
+
+package cmd
+
+import (
+	"syscall"
+
+	"golang.org/x/sys/unix"
+)
+
+// listenControl keeps the upstream behaviour on Unix: SO_REUSEPORT lets a new
+// process bind the port while the old one drains.
+func listenControl(network, address string, c syscall.RawConn) error {
+	var serr error
+	if err := c.Control(func(fd uintptr) {
+		serr = unix.SetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_REUSEPORT, 1) // #nosec G115
+	}); err != nil {
+		return err
+	}
+	return serr
+}
