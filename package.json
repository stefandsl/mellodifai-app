{
  "name": "mellodifai",
  "private": true,
  "packageManager": "pnpm@10.2.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "ops": "pnpm --dir ops exec tsx",
    "prepare": "git config core.hooksPath .githooks",
    "lint": "biome check .",
    "typecheck": "tsc -b",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test --maxWorkers=4",
    "e2e": "pnpm -r --if-present e2e",
    "test:db": "tsx ops/test-db-guard.ts && vitest run --maxWorkers=1 --no-file-parallelism supabase/tests",
    "test:integration": "tsx ops/test-db-guard.ts && vitest run --no-file-parallelism --config vitest.integration.config.mts",
    "test:ledger": "pnpm --filter @mellodifai/worker test:ledger"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@supabase/supabase-js": "^2.118.0",
    "postgres": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
